cabal-version: 3.0
name: chesshs
version: 0.1.0.0
build-type: Simple

common warnings
  ghc-options:
    -Wincomplete-patterns
    -Wincomplete-uni-patterns
    -Werror=incomplete-patterns
    -Werror=incomplete-uni-patterns
    -Worphans

library
  import: warnings
  exposed-modules:
    Actions
    BoardElements
    Chess
    ChessState
    Names
    Notation
    Parsing
    Plies
    Reach

  hs-source-dirs: src
  build-depends:
    array,
    base >=4.14 && <5,
    containers,
    parsec,

  default-language: Haskell2010

executable program
  import: warnings
  main-is: program.hs
  hs-source-dirs: app
  build-depends:
    base >=4.14 && <5,
    chesshs,

  default-language: Haskell2010

test-suite chesshs-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  other-modules:
    Arbitrary
    ChessSpec
    NotationSpec

  build-depends:
    QuickCheck,
    base >=4.14 && <5,
    chesshs,
    hspec,

  build-tool-depends: hspec-discover:hspec-discover
  default-language: Haskell2010over:hspec-discover
  default-language: Haskell2010
