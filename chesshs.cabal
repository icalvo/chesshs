cabal-version: 3.0
name: chesshs
version: 0.1.0.0
build-type: Simple

common warnings
  ghc-options:
    -Wincomplete-patterns
    -Wincomplete-uni-patterns
    -Werror=incomplete-patterns
    -Werror=incomplete-uni-patterns
    -Worphans

library
  import: warnings
  exposed-modules:
    Actions
    BoardElements
    Chess
    ChessState
    Names
    Notation
    Plies
    Reach

  hs-source-dirs: src
  build-depends:
    array,
    base >=4.14 && <5,
    containers,

  default-language: Haskell2010

executable program
  import: warnings
  main-is: program.hs
  hs-source-dirs: app
  build-depends:
    base >=4.14 && <5,
    chesshs,

  default-language: Haskell2010
